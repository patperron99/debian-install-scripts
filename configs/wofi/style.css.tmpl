* {
    font-family: "FiraCode Nerd Font", monospace;
    font-size: 14px;
}

window {
    background-color: $BG;
    border: 1px solid $SEP_COLOR;
    border-radius: 0px;
}

#input {
    background-color: $BG1;
    color: $FG;
    border: 1px solid $SEP_COLOR;
    border-radius: 0px;
    padding: 10px 14px;
    margin: 10px;
}

#input:focus {
    border-color: $ACCENT;
    outline: none;
}

#scroll {
    margin: 0 8px 8px 8px;
}

#inner-box {
    background: transparent;
}

#outer-box {
    background: transparent;
    padding: 4px;
}

#entry {
    background-color: transparent;
    border-radius: 0px;
    padding: 8px 12px;
    color: $FG_DIM;
}

#entry:selected {
    background-color: $BG1;
    color: $FG_BRIGHT;
    border-left: 3px solid $ACCENT;
}

#text {
    color: inherit;
    margin-left: 8px;
}

#img {
    margin-right: 4px;
}
