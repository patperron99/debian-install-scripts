# Sway Configuration

set $mod Mod4
set $term alacritty
set $menu wofi --show drun

# ── Environment ───────────────────────────────────────────────────────────────
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# ── Monitors ──────────────────────────────────────────────────────────────────
set $primarymonitor eDP-1
# TODO: replace with your actual secondary monitor name (run: swaymsg -t get_outputs | grep name)
set $secondarymonitor HDMI-A-1

include ~/.config/sway/workspaces.conf

# ── Output (monitors) ─────────────────────────────────────────────────────────
# Auto-detect; override with kanshi profiles (~/.config/kanshi/config)

# ── Input ─────────────────────────────────────────────────────────────────────
input "type:keyboard" {
    xkb_layout us
}

input "type:touchpad" {
    natural_scroll enabled
    dwt enabled
    tap enabled
    middle_emulation disabled
}

input "type:pointer" {
    accel_profile flat
    pointer_accel 0
}

# ── Look & Feel ───────────────────────────────────────────────────────────────
gaps inner 5
gaps outer 10

default_border pixel 2
default_floating_border pixel 2

client.focused          #d79921 #d79921 #ffffff #d79921 #d79921
client.unfocused        #504945 #504945 #888888 #504945 #504945
client.focused_inactive #504945 #504945 #888888 #504945 #504945

font pango:JetBrains Mono 10

# ── Autostart ─────────────────────────────────────────────────────────────────
exec waybar
exec mako
exec /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1
exec kanshi
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec swayidle -w \
    timeout 120  'bash ~/.local/bin/screensaver-launch.sh' \
        resume   'bash ~/.local/bin/screensaver-stop.sh' \
    timeout 300  'brightnessctl -s set 10%' \
        resume   'brightnessctl -r' \
    timeout 600  'bash ~/.local/bin/screensaver-stop.sh; hyprlock' \
    timeout 900  'swaymsg "output * dpms off"' \
        resume   'swaymsg "output * dpms on"' \
    timeout 1800 'systemctl suspend' \
    before-sleep 'hyprlock'

# ── Window Rules ──────────────────────────────────────────────────────────────
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="org.gnome.DiskUtility"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="Alacritty"] opacity 0.97
for_window [app_id="org.gnome.Nautilus"] opacity 0.95
for_window [app_id="screensaver"] fullscreen enable, border none

# ── Keybindings ───────────────────────────────────────────────────────────────

# Applications
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+e exec nautilus
bindsym $mod+b exec flatpak run app.zen_browser.zen
bindsym $mod+shift+a exec pavucontrol

# Window management
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+Shift+e exit

# Layout
bindsym $mod+j layout toggle split

# Focus
bindsym $mod+Left  focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down

# Move
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Down  move down

# Resize
bindsym $mod+minus       resize shrink width  50 px; resize shrink height 50 px
bindsym $mod+equal       resize grow   width  50 px; resize grow   height 50 px
bindsym $mod+Shift+equal resize grow   width  50 px; resize grow   height 50 px

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+button4 workspace prev
bindsym $mod+button5 workspace next

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+ctrl+minus  scratchpad show

# Lock / screensaver / power
bindsym $mod+l         exec hyprlock
bindsym $mod+Shift+l   exec bash ~/.local/bin/screensaver-launch.sh
bindsym $mod+Escape exec bash ~/.local/bin/powermenu.sh

# Clipboard history
bindsym $mod+c exec cliphist list | wofi --dmenu | cliphist decode | wl-copy

# Reload config
bindsym $mod+Shift+c reload

# Screen recording
bindsym $mod+Shift+r exec pkill wf-recorder || wf-recorder -f ~/Videos/recording-$(date +%Y%m%d-%H%M%S).mp4

# Screenshot
bindsym $mod+p       exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+p exec grim - | wl-copy
bindsym $mod+ctrl+p  exec grim ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png

# Wallpaper cycle
bindsym $mod+w exec bash ~/.local/bin/wallpaper-next.sh

# Theme picker
bindsym $mod+Shift+t exec bash ~/.local/bin/theme-picker.sh

# Media keys
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute        exec pamixer -t
bindsym XF86AudioPlay        exec playerctl play-pause
bindsym XF86AudioNext        exec playerctl next
bindsym XF86AudioPrev        exec playerctl previous

# Brightness keys
bindsym XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Mouse drag
floating_modifier $mod normal

# ── Cursor ────────────────────────────────────────────────────────────────────
seat seat0 hide_cursor 3000
seat seat0 xcursor_theme Adwaita 24
mouse_warping container

include /etc/sway/config.d/*.conf
output * bg #282828 solid_color

exec xsettingsd
exec_always autotiling
