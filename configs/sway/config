# Sway Configuration

set $mod Mod4
set $term kitty
set $menu wofi --show drun

# ── Environment ───────────────────────────────────────────────────────────────
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# ── Monitors ──────────────────────────────────────────────────────────────────
set $primarymonitor eDP-1
# TODO: replace with your actual secondary monitor name (run: swaymsg -t get_outputs | grep name)
set $secondarymonitor HDMI-A-1

include ~/.config/sway/workspaces.conf

# ── Output (monitors) ─────────────────────────────────────────────────────────
# Auto-detect; override with kanshi profiles (~/.config/kanshi/config)

# ── Input ─────────────────────────────────────────────────────────────────────
input "type:keyboard" {
    xkb_layout us
}

input "type:touchpad" {
    natural_scroll enabled
    dwt enabled
    tap enabled
    middle_emulation disabled
}

input "type:pointer" {
    accel_profile flat
    pointer_accel 0
}

# ── Look & Feel ───────────────────────────────────────────────────────────────
gaps inner 5
gaps outer 10

default_border pixel 2
default_floating_border pixel 2

client.focused          #d79921 #d79921 #ffffff #d79921 #d79921
client.unfocused        #504945 #504945 #888888 #504945 #504945
client.focused_inactive #504945 #504945 #888888 #504945 #504945

font pango:JetBrains Mono 10

# ── Autostart ─────────────────────────────────────────────────────────────────
exec waybar
exec mako
exec /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1
exec kanshi
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec swayidle -w \
    timeout 120  'bash ~/.local/bin/screensaver-launch.sh' \
        resume   'bash ~/.local/bin/screensaver-stop.sh' \
    timeout 300  'brightnessctl -s set 10%' \
        resume   'brightnessctl -r' \
    timeout 600  'bash ~/.local/bin/screensaver-lock.sh' \
    timeout 900  'swaymsg "output * dpms off"' \
        resume   'swaymsg "output * dpms on"' \
    timeout 1800 'systemctl suspend' \
    before-sleep 'pgrep -x hyprlock || hyprlock'

include ~/.config/sway/rules.conf

include ~/.config/sway/keybindings.conf

# ── Cursor ────────────────────────────────────────────────────────────────────
seat seat0 hide_cursor 3000
seat seat0 xcursor_theme Adwaita 24
mouse_warping container

include /etc/sway/config.d/*.conf
output * bg $HOME/Pictures/Wallpapers/gruvbox/default.jpg fill

exec_always autotiling
